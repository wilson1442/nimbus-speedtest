<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26 and up). The logo art is drawn on a light plate,
     so the background layer is that exact plate colour (#FCFDFC) and the foreground
     carries the same plate. No seam appears, and no risky background cut-out is
     needed (the mark has near-white speed lines that touch its own outline, so
     colour-keying the plate punches holes through the artwork). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
